{
  "info": {
    "name": "S18 Club Equipment Transport Planner - AA-02",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order. Folder 0 uses its own fresh session (autoSession/autoPlan). Folder B1 uses the session of the browser page (sessionCode/planCode set by hand)."
  },
  "item": [
    {
      "name": "0A Catalogue",
      "item": [
        {
          "name": "C1 GET equipment types",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"has EQUIP-001 and EQUIP-002\", function () { const c = pm.response.json().map(e => e.equipmentCode); pm.expect(c).to.include.members([\"EQUIP-001\",\"EQUIP-002\"]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment-types"
              ]
            }
          }
        },
        {
          "name": "C2 GET equipment type EQUIP-001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"EQUIP-001 is 4 kg with handling notes\", function () { const b = pm.response.json(); pm.expect(b.unitMassKg).to.eql(4); pm.expect(b.handlingNotes).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment-types/EQUIP-001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment-types",
                "EQUIP-001"
              ]
            }
          }
        },
        {
          "name": "C3 GET unknown equipment type (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"error_code is EQUIPMENT_NOT_FOUND\", function () { pm.expect(pm.response.json().error_code).to.eql(\"EQUIPMENT_NOT_FOUND\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment-types/EQUIP-999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "equipment-types",
                "EQUIP-999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "0B Create or reuse plan",
      "item": [
        {
          "name": "P1 POST create plan (new session, 201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"autoSession\", \"pm-run-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const planCode = pm.response.json().planCode;",
                  "pm.test(\"planCode returned\", function () { pm.expect(planCode).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"autoPlan\", planCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Code",
                "value": "{{autoSession}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/load-plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "load-plans"
              ]
            }
          }
        },
        {
          "name": "P2 POST same session again (200, same plan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"same planCode\", function () { pm.expect(pm.response.json().planCode).to.eql(pm.collectionVariables.get(\"autoPlan\")); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Code",
                "value": "{{autoSession}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/load-plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "load-plans"
              ]
            }
          }
        },
        {
          "name": "P3 POST without X-Session-Code (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"error_code is INVALID_REQUEST\", function () { pm.expect(pm.response.json().error_code).to.eql(\"INVALID_REQUEST\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/load-plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "load-plans"
              ]
            }
          }
        }
      ]
