# Copy this file to config/.env and change the values for your own machine:
#   cp config/.env.example config/.env        (macOS / Linux / Git Bash)
#   copy config\.env.example config\.env      (Windows cmd)
# config/.env holds real settings and must NOT be committed or submitted.
# docker-compose.yml also works without this file (it falls back to the
# development defaults below).

# PostgreSQL container settings
POSTGRES_DB=scenario_starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# The backend's DATABASE_URL is built inside docker-compose.yml from the three
# values above (host "database" is the Compose service name, port 5432 is the
# container-internal port):
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@database:5432/<POSTGRES_DB>